# App Configuration
PORT=3000
NODE_ENV=production
SHOPIFY_APP_URL=https://discount-guru.unbundl.com

# Shopify App Credentials (from Shopify Partners Dashboard)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SCOPES=write_products,write_metaobjects,write_metaobject_definitions,write_discounts,read_discounts

# Database URL (SQLite on Block Storage)
DATABASE_URL="file:/mnt/app_extend_storage/data/bulk-discount/dev.sqlite"
